<Window
    x:Class="WinUI3TwikitDeck.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUI3TwikitDeck.Controls"
    xmlns:viewmodels="using:WinUI3TwikitDeck.ViewModels"
    Title="Twikit Deck">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar>
            <AppBarButton Label="Add Home" Command="{Binding AddHomeColumnCommand}" />
            <AppBarButton Label="Add Search" Command="{Binding AddSearchColumnCommand}" />
        </CommandBar>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Visible">
            <ItemsRepeater ItemsSource="{Binding Columns}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ColumnViewModelBase">
                        <controls:ColumnControl ColumnViewModel="{Binding}" Width="380" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Window>
