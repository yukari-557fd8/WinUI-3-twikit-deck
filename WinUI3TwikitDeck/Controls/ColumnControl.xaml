<UserControl
    x:Class="WinUI3TwikitDeck.Controls.ColumnControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUI3TwikitDeck.Controls"
    xmlns:viewmodels="using:WinUI3TwikitDeck.ViewModels">
    <Border
        BorderThickness="1"
        BorderBrush="Gray"
        Padding="8"
        CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ElementName=Root, Path=ColumnViewModel.Header}" FontWeight="SemiBold" FontSize="16" />
                <Button
                    Grid.Column="1"
                    Content="✕"
                    Command="{Binding ElementName=Root, Path=ColumnViewModel.RemoveColumnCommand}"
                    CommandParameter="{Binding ElementName=Root, Path=ColumnViewModel}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto">
                <ItemsRepeater ItemsSource="{Binding ElementName=Root, Path=ColumnViewModel.Tweets}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:TweetControlHost Tweet="{Binding}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
