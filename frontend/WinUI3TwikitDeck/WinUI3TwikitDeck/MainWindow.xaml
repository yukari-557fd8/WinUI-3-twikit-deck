<Window
    x:Class="WinUI3TwikitDeck.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUI3TwikitDeck.Controls"
    xmlns:viewmodels="using:WinUI3TwikitDeck.ViewModels"
    Title="WinUI 3 TweetDeck">
    <Grid x:Name="RootGrid" Background="{ThemeResource DeckPageBackgroundBrush}">
        <Grid.Resources>
            <!--
              Twikit の状態表示。Foreground をコードから直接代入するとテーマ参照が切れて
              ライト / ダーク切り替えに追従しなくなるため、ThemeResource を持つ Style を切り替える。
            -->
            <Style x:Key="StatusTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{ThemeResource CommandBarForeground}" />
            </Style>
            <Style x:Key="StatusTextWarningStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnComposeAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnRefreshAccelerator" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnRefreshAccelerator" />
        </Grid.KeyboardAccelerators>

        <!--
          上段: 左に Twikit の状態（Ready ✅ / ❌）と時計、右にコマンドバー。
          CommandBar.Content に入れると動的オーバーフローの計算に含まれず右端のボタンが切れるため、
          2 列の Grid にしてステータス側（*）を縮め、ボタン側（Auto）を常に残す。
        -->
        <Grid Background="{ThemeResource CommandBarBackground}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TwikitStatusText"
                    Text="Twikit: Checking..."
                    Style="{StaticResource StatusTextStyle}"
                    MaxWidth="480"
                    AutomationProperties.Name="Twikit の状態" />
                <TextBlock
                    x:Name="ClockText"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource CommandBarForeground}"
                    AutomationProperties.Name="時計" />
            </StackPanel>

        <CommandBar
            Grid.Column="1"
            OverflowButtonVisibility="Collapsed"
            IsDynamicOverflowEnabled="False"
            DefaultLabelPosition="Right"
            Background="{ThemeResource CommandBarBackground}"
            Foreground="{ThemeResource CommandBarForeground}">
            <AppBarButton Icon="Edit" Label="ツイート" Click="OnComposeClick" ToolTipService.ToolTip="新しいツイート (Ctrl+N)" />
            <AppBarButton Icon="Add" Label="カラムを追加">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="ホーム" Command="{Binding AddHomeColumnCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE80F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="通知" Command="{Binding AddNotificationsColumnCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEA8F;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="メンション" Command="{Binding AddMentionsColumnCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8BD;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="検索…" Click="OnAddSearchClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE721;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="リスト…" Click="OnAddListClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEA37;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="ユーザー…" Click="OnAddUserClick">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE77B;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton Icon="Refresh" Label="すべて更新" Command="{Binding RefreshAllCommand}" ToolTipService.ToolTip="すべてのカラムを更新 (F5)" />
            <AppBarButton Icon="View" Label="表示" ToolTipService.ToolTip="表示の設定">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom" Opening="ViewMenu_Opening">
                        <!-- オンのときは各カラムの幅設定（狭い / 標準 / 広い）を比率として、カラム領域の幅を配分する -->
                        <ToggleMenuFlyoutItem
                            x:Name="FitColumnsItem"
                            Text="カラム幅をウィンドウに合わせる"
                            Click="FitColumnsItem_Click" />
                        <MenuFlyoutSeparator />
                        <!-- カラムの種類・順序・幅などを deck_columns.json と同じ形式のファイルへ書き出す / 読み込む -->
                        <MenuFlyoutItem
                            Text="カラム構成をエクスポート…"
                            Click="OnExportLayoutClick"
                            ToolTipService.ToolTip="今のカラム構成を WinUI3TwikitDeckState.json として保存します">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74E;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            Text="カラム構成をインポート…"
                            Click="OnImportLayoutClick"
                            ToolTipService.ToolTip="エクスポートしたファイルを読み込んで、今のカラムを置き換えます">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8E5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Icon="Setting" Label="設定" Click="OnSettingsClick" />
        </CommandBar>
        </Grid>

        <InfoBar
            x:Name="NotificationBar"
            Grid.Row="1"
            Margin="12,4,12,0"
            IsOpen="False" />

        <!--
          横スクロール専用。VerticalScrollBarVisibility を Disabled にしないと縦方向が無限の高さで計測され、
          各カラムが中身の高さまで伸びてカラム内の縦スクロールが効かなくなる。
          幅の変化は MainViewModel.ViewportWidth に渡し、「カラム幅をウィンドウに合わせる」モードの配分に使う。
          StackLayout の Spacing は MainViewModel.ColumnSpacing と合わせること。
        -->
        <ScrollViewer
            x:Name="DeckScrollViewer"
            Grid.Row="2"
            HorizontalScrollMode="Enabled"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled"
            Padding="12,8,12,0"
            SizeChanged="DeckScrollViewer_SizeChanged">
            <ItemsRepeater ItemsSource="{Binding Columns}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ColumnViewModelBase">
                        <controls:ColumnControl ColumnViewModel="{x:Bind}" Width="{x:Bind DisplayWidth, Mode=OneWay}" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Window>
