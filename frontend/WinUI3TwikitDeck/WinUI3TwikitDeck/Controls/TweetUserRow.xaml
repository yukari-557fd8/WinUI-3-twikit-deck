<UserControl
    x:Class="WinUI3TwikitDeck.Controls.TweetUserRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinUI3TwikitDeck.Controls">
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <PersonPicture
            Width="40"
            Height="40"
            VerticalAlignment="Center"
            ProfilePicture="{x:Bind UserProfileImage, Mode=OneWay}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock
                    Text="{x:Bind UserName, Mode=OneWay}"
                    FontSize="15"
                    LineHeight="20"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center" />
                <FontIcon
                    Glyph="&#xE73E;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="#1D9BF0"
                    Visibility="{x:Bind IsUserVerified, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <FontIcon
                    Glyph="&#xE72E;"
                    FontSize="12"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Visibility="{x:Bind IsUserProtected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind MetaLine, Mode=OneWay}"
                FontSize="13"
                LineHeight="18"
                FontWeight="Light"
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel
                Orientation="Horizontal"
                Visibility="{x:Bind HasReplyTo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock
                    Text="返信先: "
                    FontSize="13"
                    LineHeight="18"
                    FontWeight="Light"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="{x:Bind ReplyToDisplay, Mode=OneWay}"
                    Margin="4,0,0,0"
                    FontSize="13"
                    LineHeight="18"
                    FontWeight="Light"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
