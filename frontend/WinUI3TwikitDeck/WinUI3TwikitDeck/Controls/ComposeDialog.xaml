<ContentDialog
    x:Class="WinUI3TwikitDeck.Controls.ComposeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:compose="using:WinUI3TwikitDeck.Compose"
    Title="ツイート"
    PrimaryButtonText="ツイートする"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="480">
        <Border
            x:Name="TargetPanel"
            Visibility="Collapsed"
            BorderBrush="{ThemeResource QuotedTweetCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="10"
            Background="{ThemeResource QuotedTweetCardBackgroundBrush}">
            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="TargetLabel"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    x:Name="TargetText"
                    TextWrapping="Wrap"
                    MaxLines="3"
                    TextTrimming="CharacterEllipsis"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <TextBox
            x:Name="InputBox"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            Height="150"
            TextChanged="InputBox_TextChanged"
            Paste="InputBox_Paste"
            PlaceholderText="いまどうしてる？（画像 4 枚まで、または動画・GIF 1 件。Ctrl+V でも添付できます）">
            <TextBox.KeyboardAccelerators>
                <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="InputBox_CtrlEnterInvoked" />
            </TextBox.KeyboardAccelerators>
        </TextBox>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AddMediaButton" Click="OnAddMediaClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xEB9F;" FontSize="14" />
                    <TextBlock Text="メディアを追加" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="MediaSummary"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                x:Name="CountText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Text="0 / 280"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ProgressRing
                x:Name="PostingRing"
                Grid.Column="3"
                Width="20"
                Height="20"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <ScrollViewer
            x:Name="MediaStrip"
            Visibility="Collapsed"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Disabled">
            <ItemsControl ItemsSource="{x:Bind SelectedFiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="compose:MediaFile">
                        <StackPanel Width="120" Spacing="4">
                            <Grid Height="120">
                                <Border
                                    CornerRadius="8"
                                    Background="{ThemeResource TweetMediaPreviewBackgroundBrush}"
                                    BorderBrush="{ThemeResource TweetMediaPreviewBorderBrush}"
                                    BorderThickness="1">
                                    <Grid>
                                        <Image Source="{x:Bind Preview, Mode=OneWay}" Stretch="UniformToFill" />
                                        <TextBlock
                                            Text="{x:Bind FileName}"
                                            TextWrapping="Wrap"
                                            TextTrimming="CharacterEllipsis"
                                            MaxLines="3"
                                            Margin="8"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Visibility="{x:Bind IsVideo}" />
                                    </Grid>
                                </Border>
                                <Button
                                    Content="&#xE8BB;"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="10"
                                    Padding="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="4"
                                    Click="RemoveMedia_Click"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="この添付を外す" />
                            </Grid>
                            <TextBlock
                                Text="{x:Bind ProgressText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                MaxLines="3"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock
            x:Name="StatusText"
            TextWrapping="Wrap"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </StackPanel>
</ContentDialog>
