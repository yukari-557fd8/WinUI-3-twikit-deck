<UserControl
    x:Class="WinUI3TwikitDeck.Controls.TweetCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUI3TwikitDeck.Controls"
    x:DefaultBindMode="OneWay">
    <UserControl.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <controls:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <controls:InverseBoolConverter x:Key="InverseBoolConverter" />
        <controls:LikeColorConverter x:Key="LikeColorConverter" />
        <controls:RetweetColorConverter x:Key="RetweetColorConverter" />
    </UserControl.Resources>

    <!-- クリックでカラム内に会話を開く（ボタン・リンク・メディア・引用はそれぞれの動作を優先） -->
    <Border
        x:Name="CardBorder"
        Margin="0,4"
        Padding="12"
        CornerRadius="12"
        Background="{ThemeResource TweetCardBackgroundBrush}"
        BorderBrush="{ThemeResource TweetCardBorderBrush}"
        BorderThickness="1"
        PointerEntered="CardBorder_PointerEntered"
        PointerExited="CardBorder_PointerExited"
        PointerCanceled="CardBorder_PointerExited"
        PointerCaptureLost="CardBorder_PointerExited">
        <!--
          状態はルート（UserControl の中身の最上位）に置かないと GoToState が見つけられない。
          引用部分は x:Load なので、QuotePointerOver には読み込み済みの QuoteBorder の PointerEntered からだけ入る。
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CardPointerStates">
                <VisualState x:Name="CardNormal" />
                <VisualState x:Name="CardPointerOver">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.Background" Value="{ThemeResource TweetCardHoverBackgroundBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="FocalStates">
                <VisualState x:Name="NotFocal" />
                <VisualState x:Name="Focal">
                    <VisualState.Setters>
                        <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="QuotePointerStates">
                <VisualState x:Name="QuoteNormal" />
                <VisualState x:Name="QuotePointerOver">
                    <VisualState.Setters>
                        <Setter Target="QuoteBorder.Background" Value="{ThemeResource QuotedTweetCardHoverBackgroundBrush}" />
                        <Setter Target="QuoteBorder.BorderBrush" Value="{ThemeResource QuotedTweetCardHoverBorderBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Spacing="10">
            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind Tweet.IsPinned, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE718;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="固定されたツイート"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                Spacing="6"
                Visibility="{x:Bind Tweet.IsRetweet, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="{x:Bind Tweet.RetweetHeaderText}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <controls:TweetUserRow
                UserName="{x:Bind Tweet.UserName}"
                UserScreenName="{x:Bind Tweet.UserScreenName}"
                UserProfileImage="{x:Bind Tweet.ProfileImage}"
                IsUserProtected="{x:Bind Tweet.IsUserProtected}"
                IsUserVerified="{x:Bind Tweet.IsUserVerified}"
                CreatedAtAbsoluteDisplay="{x:Bind Tweet.CreatedAtAbsoluteDisplay}"
                CreatedAtRelativeDisplay="{x:Bind Tweet.CreatedAtRelativeDisplay}"
                ReplyToDisplay="{x:Bind Tweet.ReplyToDisplay}"
                HasReplyTo="{x:Bind ReplyToVisible(Tweet.HasReplyTo, ShowReplyTo)}" />

            <controls:TweetTextBlock
                Text="{x:Bind Tweet.Text}"
                Urls="{x:Bind Tweet.Urls}"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Visibility="{x:Bind Tweet.HasText, Converter={StaticResource BoolToVisibilityConverter}}" />

            <controls:MediaGrid Items="{x:Bind Tweet.MediaItems}" TileHeight="120" />

            <Border
                x:Name="QuoteBorder"
                x:Load="{x:Bind Tweet.HasQuotedTweet}"
                BorderBrush="{ThemeResource QuotedTweetCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Background="{ThemeResource QuotedTweetCardBackgroundBrush}"
                IsHitTestVisible="{x:Bind Tweet.QuotedTweet.IsUnavailable, Converter={StaticResource InverseBoolConverter}}"
                PointerEntered="QuoteBorder_PointerEntered"
                PointerExited="QuoteBorder_PointerExited"
                Tapped="QuoteBorder_Tapped"
                ToolTipService.ToolTip="引用元をブラウザで開く">
                <StackPanel Spacing="10">
                    <controls:TweetUserRow
                        Visibility="{x:Bind Tweet.QuotedTweet.IsUnavailable, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                        UserName="{x:Bind Tweet.QuotedTweet.UserName}"
                        UserScreenName="{x:Bind Tweet.QuotedTweet.UserScreenName}"
                        UserProfileImage="{x:Bind Tweet.QuotedTweet.ProfileImage}"
                        IsUserProtected="{x:Bind Tweet.QuotedTweet.IsUserProtected}"
                        IsUserVerified="{x:Bind Tweet.QuotedTweet.IsUserVerified}"
                        CreatedAtAbsoluteDisplay="{x:Bind Tweet.QuotedTweet.CreatedAtAbsoluteDisplay}"
                        CreatedAtRelativeDisplay="{x:Bind Tweet.QuotedTweet.CreatedAtRelativeDisplay}" />
                    <controls:TweetTextBlock
                        Text="{x:Bind Tweet.QuotedTweet.Text}"
                        Urls="{x:Bind Tweet.QuotedTweet.Urls}"
                        TextFontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Visibility="{x:Bind Tweet.QuotedTweet.HasText, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <controls:MediaGrid Items="{x:Bind Tweet.QuotedTweet.MediaItems}" TileHeight="90" />
                    <TextBlock
                        Text="このツイートは表示できません"
                        FontStyle="Italic"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind Tweet.QuotedTweet.IsUnavailable, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <!-- 幅 300 のカラムでも収まるよう、余白は最小限にする -->
            <Grid ColumnSpacing="0" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Style="{StaticResource DeckActionButtonStyle}"
                    Click="ReplyButton_Click"
                    ToolTipService.ToolTip="返信">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind Tweet.ReplyCountDisplay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- DropDownButton の既定スタイルは generic.xaml 側にあり App.xaml から BasedOn できないため、ここで直接指定する -->
                <DropDownButton
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4,4,2,4"
                    MinWidth="0"
                    MinHeight="28"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    IsEnabled="{x:Bind Tweet.IsRetweetEnabled}"
                    ToolTipService.ToolTip="リツイート / 引用">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" Foreground="{x:Bind Tweet.IsRetweeted, Converter={StaticResource RetweetColorConverter}}" />
                        <TextBlock Text="{x:Bind Tweet.RetweetCountDisplay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="{x:Bind Tweet.RetweetMenuText}" Click="RetweetMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="引用ツイート" Click="QuoteMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE70F;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <Button
                    Grid.Column="2"
                    Style="{StaticResource DeckActionButtonStyle}"
                    Click="LikeButton_Click"
                    ToolTipService.ToolTip="いいね">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="{x:Bind LikeGlyph(Tweet.IsLiked)}" FontSize="15" Foreground="{x:Bind Tweet.IsLiked, Converter={StaticResource LikeColorConverter}}" />
                        <TextBlock Text="{x:Bind Tweet.FavoriteCountDisplay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center"
                    Margin="6,0,0,0"
                    ToolTipService.ToolTip="インプレッション">
                    <FontIcon Glyph="&#xEA37;" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{x:Bind Tweet.ViewCountDisplay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <Button
                    Grid.Column="4"
                    Style="{StaticResource DeckActionButtonStyle}"
                    Click="OpenInBrowser_Click"
                    ToolTipService.ToolTip="ブラウザで開く">
                    <FontIcon Glyph="&#xE8A7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
