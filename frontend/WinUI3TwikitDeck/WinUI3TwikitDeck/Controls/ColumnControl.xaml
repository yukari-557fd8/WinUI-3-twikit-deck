<UserControl
    x:Class="WinUI3TwikitDeck.Controls.ColumnControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUI3TwikitDeck.Controls"
    xmlns:models="using:WinUI3TwikitDeck.Models"
    xmlns:viewmodels="using:WinUI3TwikitDeck.ViewModels"
    x:DefaultBindMode="OneWay">
    <UserControl.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <DataTemplate x:Key="TweetTemplate" x:DataType="models:TweetCardModel">
            <controls:TweetCard Tweet="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="NotificationTemplate" x:DataType="models:NotificationCardModel">
            <controls:NotificationCard Notification="{x:Bind}" />
        </DataTemplate>
        <controls:ColumnItemTemplateSelector
            x:Key="ItemSelector"
            TweetTemplate="{StaticResource TweetTemplate}"
            NotificationTemplate="{StaticResource NotificationTemplate}" />

        <!--
          会話の行。返信の連鎖はカード間の余白（上下 4px ずつ）に引く線でつなぐ。
          横位置はアイコンの中心（カードの枠 1 + 余白 12 + アイコンの半径 20 = 33）
        -->
        <DataTemplate x:Key="ConversationTweetTemplate" x:DataType="viewmodels:ConversationEntry">
            <Grid>
                <Rectangle
                    Width="2"
                    Height="4"
                    Margin="32,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource ConversationLineBrush}"
                    Visibility="{x:Bind HasLineAbove, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Rectangle
                    Width="2"
                    Height="4"
                    Margin="32,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource ConversationLineBrush}"
                    Visibility="{x:Bind HasLineBelow, Converter={StaticResource BoolToVisibilityConverter}}" />
                <!-- 返信の連鎖は線で表すので「返信先」は出さない -->
                <controls:TweetCard Tweet="{x:Bind Tweet}" IsFocal="{x:Bind IsFocal}" ShowReplyTo="False" />
            </Grid>
        </DataTemplate>
        <!--
          表示できない返信元。削除・凍結などは X の説明文を出す。
          X が流れの途中から返しただけのときは、そのツイートの会話を開き直せば続きが出ることもある
        -->
        <DataTemplate x:Key="ConversationMissingTemplate" x:DataType="viewmodels:ConversationEntry">
            <Grid>
                <Rectangle
                    Width="2"
                    Height="4"
                    Margin="32,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource ConversationLineBrush}"
                    Visibility="{x:Bind HasLineAbove, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Rectangle
                    Width="2"
                    Height="4"
                    Margin="32,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Fill="{ThemeResource ConversationLineBrush}"
                    Visibility="{x:Bind HasLineBelow, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Border
                    Margin="0,4"
                    Padding="12,10"
                    CornerRadius="12"
                    Background="{ThemeResource QuotedTweetCardBackgroundBrush}"
                    BorderBrush="{ThemeResource TweetCardBorderBrush}"
                    BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind MissingText}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="WrapWholeWords"
                            VerticalAlignment="Center" />
                        <!-- クリックでフォーカスを取ると、行が消えたときにフォーカスが他のカラムへ飛ぶので取らない -->
                        <HyperlinkButton
                            Grid.Column="1"
                            Content="開く"
                            Tag="{x:Bind MissingTweetId}"
                            Click="OpenMissingTweet_Click"
                            AllowFocusOnInteraction="False"
                            ToolTipService.ToolTip="このツイートの会話を開く"
                            Visibility="{x:Bind CanOpenMissing, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ConversationRepliesHeaderTemplate" x:DataType="viewmodels:ConversationEntry">
            <StackPanel Margin="4,12,0,4" Spacing="8">
                <TextBlock Text="返信" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="返信はありません"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Visibility="{x:Bind ShowNoReplies, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>
        <controls:ConversationItemTemplateSelector
            x:Key="ConversationItemSelector"
            TweetTemplate="{StaticResource ConversationTweetTemplate}"
            MissingTemplate="{StaticResource ConversationMissingTemplate}"
            RepliesHeaderTemplate="{StaticResource ConversationRepliesHeaderTemplate}" />
    </UserControl.Resources>

    <Border
        Background="{ThemeResource ColumnBackgroundBrush}"
        BorderBrush="{ThemeResource ColumnBorderBrush}"
        BorderThickness="1"
        Padding="8"
        CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock
                        Text="{x:Bind ColumnViewModel.Header}"
                        FontWeight="SemiBold"
                        FontSize="15"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ColumnViewModel.Subtitle}"
                        Visibility="{x:Bind ColumnViewModel.HasSubtitle, Converter={StaticResource BoolToVisibilityConverter}}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Style="{StaticResource DeckIconButtonStyle}"
                    Command="{x:Bind ColumnViewModel.RefreshCommand}"
                    AutomationProperties.Name="更新"
                    ToolTipService.ToolTip="更新">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button
                    Grid.Column="2"
                    Style="{StaticResource DeckIconButtonStyle}"
                    AutomationProperties.Name="カラムの設定"
                    ToolTipService.ToolTip="カラムの設定">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="ColumnMenu_Opening">
                            <MenuFlyoutSubItem Text="自動更新">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE823;" />
                                </MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="IntervalManualItem" Text="手動" Tag="0" Click="IntervalItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="Interval1Item" Text="1分" Tag="60" Click="IntervalItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="Interval2Item" Text="2分" Tag="120" Click="IntervalItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="Interval5Item" Text="5分" Tag="300" Click="IntervalItem_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="カラムの幅">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE9A6;" />
                                </MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="WidthNarrowItem" Text="狭い" Tag="300" Click="WidthItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="WidthNormalItem" Text="標準" Tag="380" Click="WidthItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="WidthWideItem" Text="広い" Tag="480" Click="WidthItem_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Text="左へ移動"
                                Command="{x:Bind ColumnViewModel.MoveLeftCommand}"
                                CommandParameter="{x:Bind ColumnViewModel}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="右へ移動"
                                Command="{x:Bind ColumnViewModel.MoveRightCommand}"
                                CommandParameter="{x:Bind ColumnViewModel}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Text="カラムを閉じる"
                                Command="{x:Bind ColumnViewModel.RemoveColumnCommand}"
                                CommandParameter="{x:Bind ColumnViewModel}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8BB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!--
              タイムライン。会話を開いている間は上に会話を重ね、ここは無効・透明にする（コードで切り替え）。
              折りたたまないので、裏でも自動更新が続き、戻ったときにスクロール位置がそのまま残る。
            -->
            <ContentControl
                x:Name="TimelineHost"
                Grid.Row="1"
                IsTabStop="False"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                  TabView は選択タブを BringIntoView するが、その要求がデッキの横スクロール ScrollViewer まで伝わり、
                  右端のカラムのタブに合わせてデッキ全体が横にスクロールしてしまう。タブ側で止める。
                -->
                <TabView x:Name="TimelineTabView"
                         TabWidthMode="SizeToContent"
                         SelectedIndex="0"
                         IsAddTabButtonVisible="False"
                         CanDragTabs="False"
                         CanReorderTabs="False"
                         SelectionChanged="TimelineTabView_SelectionChanged"
                         BringIntoViewRequested="TabView_BringIntoViewRequested"
                         Margin="0,8,0,4"
                         Visibility="Collapsed">
                    <TabView.TabItems>
                        <TabViewItem Header="おすすめ" Tag="for_you" IsClosable="False" />
                        <TabViewItem Header="最新" Tag="latest" IsClosable="False" />
                    </TabView.TabItems>
                </TabView>

                <!-- ユーザーカラム: ツイート（オリジナルのみ）/ 返信 / リポスト / メディア（写真・動画はプルダウンで切り替え） -->
                <TabView x:Name="UserTabView"
                         TabWidthMode="SizeToContent"
                         SelectedIndex="0"
                         IsAddTabButtonVisible="False"
                         CanDragTabs="False"
                         CanReorderTabs="False"
                         SelectionChanged="UserTabView_SelectionChanged"
                         BringIntoViewRequested="TabView_BringIntoViewRequested"
                         Margin="0,8,0,4"
                         Visibility="Collapsed">
                    <TabView.TabStripFooter>
                        <DropDownButton
                            x:Name="MediaKindButton"
                            Visibility="Collapsed"
                            Margin="6,0,0,0"
                            Padding="8,4"
                            MinHeight="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="メディアの種類"
                            ToolTipService.ToolTip="写真 / 動画を切り替え">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="Bottom">
                                    <MenuFlyoutItem Text="写真" Tag="photos" Click="MediaKindItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xEB9F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="動画" Tag="videos" Click="MediaKindItem_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE714;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </TabView.TabStripFooter>
                    <TabView.TabItems>
                        <TabViewItem Header="ツイート" Tag="tweets" IsClosable="False" />
                        <TabViewItem Header="返信" Tag="replies" IsClosable="False" />
                        <TabViewItem Header="リポスト" Tag="retweets" IsClosable="False" />
                        <TabViewItem Header="メディア" Tag="media" IsClosable="False" />
                    </TabView.TabItems>
                </TabView>

                <ProgressBar
                    Grid.Row="1"
                    IsIndeterminate="True"
                    Margin="0,4,0,2"
                    Visibility="{x:Bind ColumnViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                <InfoBar
                    Grid.Row="2"
                    Severity="Error"
                    IsClosable="False"
                    Margin="0,4"
                    IsOpen="{x:Bind ColumnViewModel.HasError}"
                    Message="{x:Bind ColumnViewModel.ErrorMessage}">
                    <InfoBar.ActionButton>
                        <Button Content="再試行" Command="{x:Bind ColumnViewModel.RefreshCommand}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ScrollViewer
                    x:Name="TweetScrollViewer"
                    Grid.Row="3"
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.AutomationId="TimelineScrollViewer"
                    ViewChanged="TweetScrollViewer_ViewChanged">
                    <StackPanel>
                        <Grid>
                            <ItemsRepeater ItemsSource="{x:Bind ColumnViewModel.Tweets}" ItemTemplate="{StaticResource ItemSelector}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="0" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                            <TextBlock
                                Text="ツイートがありません"
                                Margin="0,32,0,0"
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="{x:Bind ColumnViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>

                        <!-- 末尾: 自動取得のフォールバック（中身が少なくてスクロールできない場合など） -->
                        <Grid
                            Margin="0,8,0,12"
                            Visibility="{x:Bind FooterVisibility(ColumnViewModel.HasMore, ColumnViewModel.IsLoadingMore)}">
                            <Button
                                HorizontalAlignment="Stretch"
                                Content="さらに読み込む"
                                Command="{x:Bind ColumnViewModel.LoadMoreCommand}"
                                Visibility="{x:Bind LoadMoreButtonVisibility(ColumnViewModel.HasMore, ColumnViewModel.IsLoadingMore)}" />
                            <ProgressRing
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Center"
                                IsActive="{x:Bind ColumnViewModel.IsLoadingMore}"
                                Visibility="{x:Bind ColumnViewModel.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </ContentControl>

            <!--
              カラム内の会話（返信元の流れ → 開いたツイート → 返信）。表示 / 非表示はコードで切り替える。
              ボタンのフォーカスなどの BringIntoView がデッキの横スクロールまで伝わらないよう、ここで止める。
            -->
            <Grid
                x:Name="ConversationPanel"
                Grid.Row="1"
                Background="{ThemeResource ColumnBackgroundBrush}"
                Visibility="Collapsed"
                BringIntoViewRequested="ConversationPanel_BringIntoViewRequested">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 左矢印でひとつ前の会話、または元のタイムラインへ戻る（マウスの戻るボタンでも戻る） -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,4">
                    <Button
                        x:Name="ConversationBackButton"
                        Style="{StaticResource DeckIconButtonStyle}"
                        Click="ConversationBackButton_Click"
                        AutomationProperties.Name="戻る"
                        AutomationProperties.AutomationId="ConversationBackButton"
                        ToolTipService.ToolTip="戻る">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <TextBlock
                        Text="会話"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <ProgressBar
                    Grid.Row="1"
                    IsIndeterminate="True"
                    Margin="0,4,0,2"
                    Visibility="{x:Bind ColumnViewModel.Conversation.IsLoading, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

                <TextBlock
                    Grid.Row="2"
                    Margin="4,16"
                    Text="{x:Bind ColumnViewModel.Conversation.ErrorMessage}"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    TextWrapping="WrapWholeWords"
                    Visibility="{x:Bind ColumnViewModel.Conversation.HasError, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />

                <ScrollViewer
                    x:Name="ConversationScrollViewer"
                    Grid.Row="3"
                    VerticalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    AutomationProperties.AutomationId="ConversationScrollViewer"
                    ViewChanged="ConversationScrollViewer_ViewChanged">
                    <StackPanel>
                        <ItemsRepeater x:Name="ConversationRepeater" ItemTemplate="{StaticResource ConversationItemSelector}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <ProgressRing
                            Width="24"
                            Height="24"
                            Margin="0,8,0,12"
                            HorizontalAlignment="Center"
                            IsActive="{x:Bind ColumnViewModel.Conversation.IsLoadingMore, FallbackValue=False}"
                            Visibility="{x:Bind ColumnViewModel.Conversation.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <TextBlock
                Grid.Row="2"
                Margin="4,6,4,0"
                Text="{x:Bind FooterText(ColumnViewModel.LastUpdatedDisplay, ColumnViewModel.RefreshIntervalLabel)}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Border>
</UserControl>
