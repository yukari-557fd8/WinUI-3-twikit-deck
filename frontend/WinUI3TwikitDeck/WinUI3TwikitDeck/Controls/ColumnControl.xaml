<UserControl
    x:Class="WinUI3TwikitDeck.Controls.ColumnControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUI3TwikitDeck.Controls"
    xmlns:models="using:WinUI3TwikitDeck.Models"
    xmlns:viewmodels="using:WinUI3TwikitDeck.ViewModels"
    x:DefaultBindMode="OneWay">
    <UserControl.Resources>
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <DataTemplate x:Key="TweetTemplate" x:DataType="models:TweetCardModel">
            <controls:TweetCard Tweet="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="NotificationTemplate" x:DataType="models:NotificationCardModel">
            <controls:NotificationCard Notification="{x:Bind}" />
        </DataTemplate>
        <controls:ColumnItemTemplateSelector
            x:Key="ItemSelector"
            TweetTemplate="{StaticResource TweetTemplate}"
            NotificationTemplate="{StaticResource NotificationTemplate}" />
    </UserControl.Resources>

    <Border
        Background="{ThemeResource ColumnBackgroundBrush}"
        BorderBrush="{ThemeResource ColumnBorderBrush}"
        BorderThickness="1"
        Padding="8"
        CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock
                        Text="{x:Bind ColumnViewModel.Header}"
                        FontWeight="SemiBold"
                        FontSize="15"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Text="{x:Bind ColumnViewModel.Subtitle}"
                        Visibility="{x:Bind ColumnViewModel.HasSubtitle, Converter={StaticResource BoolToVisibilityConverter}}"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource DeckIconButtonStyle}"
                    Command="{x:Bind ColumnViewModel.RefreshCommand}"
                    AutomationProperties.Name="更新"
                    ToolTipService.ToolTip="更新">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <Button
                    Grid.Column="2"
                    Style="{StaticResource DeckIconButtonStyle}"
                    AutomationProperties.Name="カラムの設定"
                    ToolTipService.ToolTip="カラムの設定">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="ColumnMenu_Opening">
                            <MenuFlyoutSubItem Text="自動更新">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE823;" />
                                </MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="IntervalManualItem" Text="手動" Tag="0" Click="IntervalItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="Interval1Item" Text="1分" Tag="60" Click="IntervalItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="Interval2Item" Text="2分" Tag="120" Click="IntervalItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="Interval5Item" Text="5分" Tag="300" Click="IntervalItem_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="カラムの幅">
                                <MenuFlyoutSubItem.Icon>
                                    <FontIcon Glyph="&#xE9A6;" />
                                </MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="WidthNarrowItem" Text="狭い" Tag="300" Click="WidthItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="WidthNormalItem" Text="標準" Tag="380" Click="WidthItem_Click" />
                                <ToggleMenuFlyoutItem x:Name="WidthWideItem" Text="広い" Tag="480" Click="WidthItem_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Text="左へ移動"
                                Command="{x:Bind ColumnViewModel.MoveLeftCommand}"
                                CommandParameter="{x:Bind ColumnViewModel}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72B;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem
                                Text="右へ移動"
                                Command="{x:Bind ColumnViewModel.MoveRightCommand}"
                                CommandParameter="{x:Bind ColumnViewModel}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE72A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Text="カラムを閉じる"
                                Command="{x:Bind ColumnViewModel.RemoveColumnCommand}"
                                CommandParameter="{x:Bind ColumnViewModel}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8BB;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!--
              TabView は選択タブを BringIntoView するが、その要求がデッキの横スクロール ScrollViewer まで伝わり、
              右端のカラムのタブに合わせてデッキ全体が横にスクロールしてしまう。タブ側で止める。
            -->
            <TabView x:Name="TimelineTabView"
                     TabWidthMode="SizeToContent"
                     SelectedIndex="0"
                     IsAddTabButtonVisible="False"
                     CanDragTabs="False"
                     CanReorderTabs="False"
                     SelectionChanged="TimelineTabView_SelectionChanged"
                     BringIntoViewRequested="TabView_BringIntoViewRequested"
                     Margin="0,8,0,4"
                     Grid.Row="1"
                     Visibility="Collapsed">
                <TabView.TabItems>
                    <TabViewItem Header="おすすめ" Tag="for_you" IsClosable="False" />
                    <TabViewItem Header="最新" Tag="latest" IsClosable="False" />
                </TabView.TabItems>
            </TabView>

            <!-- ユーザーカラム: ツイート（オリジナルのみ）/ 返信 / リポスト / メディア（写真・動画はプルダウンで切り替え） -->
            <TabView x:Name="UserTabView"
                     TabWidthMode="SizeToContent"
                     SelectedIndex="0"
                     IsAddTabButtonVisible="False"
                     CanDragTabs="False"
                     CanReorderTabs="False"
                     SelectionChanged="UserTabView_SelectionChanged"
                     BringIntoViewRequested="TabView_BringIntoViewRequested"
                     Margin="0,8,0,4"
                     Grid.Row="1"
                     Visibility="Collapsed">
                <TabView.TabStripFooter>
                    <DropDownButton
                        x:Name="MediaKindButton"
                        Visibility="Collapsed"
                        Margin="6,0,0,0"
                        Padding="8,4"
                        MinHeight="0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="メディアの種類"
                        ToolTipService.ToolTip="写真 / 動画を切り替え">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="写真" Tag="photos" Click="MediaKindItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEB9F;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="動画" Tag="videos" Click="MediaKindItem_Click">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE714;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </TabView.TabStripFooter>
                <TabView.TabItems>
                    <TabViewItem Header="ツイート" Tag="tweets" IsClosable="False" />
                    <TabViewItem Header="返信" Tag="replies" IsClosable="False" />
                    <TabViewItem Header="リポスト" Tag="retweets" IsClosable="False" />
                    <TabViewItem Header="メディア" Tag="media" IsClosable="False" />
                </TabView.TabItems>
            </TabView>

            <ProgressBar
                Grid.Row="2"
                IsIndeterminate="True"
                Margin="0,4,0,2"
                Visibility="{x:Bind ColumnViewModel.IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

            <InfoBar
                Grid.Row="3"
                Severity="Error"
                IsClosable="False"
                Margin="0,4"
                IsOpen="{x:Bind ColumnViewModel.HasError}"
                Message="{x:Bind ColumnViewModel.ErrorMessage}">
                <InfoBar.ActionButton>
                    <Button Content="再試行" Command="{x:Bind ColumnViewModel.RefreshCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ScrollViewer
                x:Name="TweetScrollViewer"
                Grid.Row="4"
                VerticalScrollMode="Enabled"
                VerticalScrollBarVisibility="Auto"
                ViewChanged="TweetScrollViewer_ViewChanged">
                <StackPanel>
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ColumnViewModel.Tweets}" ItemTemplate="{StaticResource ItemSelector}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="0" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                        <TextBlock
                            Text="ツイートがありません"
                            Margin="0,32,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Visibility="{x:Bind ColumnViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>

                    <!-- 末尾: 自動取得のフォールバック（中身が少なくてスクロールできない場合など） -->
                    <Grid
                        Margin="0,8,0,12"
                        Visibility="{x:Bind FooterVisibility(ColumnViewModel.HasMore, ColumnViewModel.IsLoadingMore)}">
                        <Button
                            HorizontalAlignment="Stretch"
                            Content="さらに読み込む"
                            Command="{x:Bind ColumnViewModel.LoadMoreCommand}"
                            Visibility="{x:Bind LoadMoreButtonVisibility(ColumnViewModel.HasMore, ColumnViewModel.IsLoadingMore)}" />
                        <ProgressRing
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            IsActive="{x:Bind ColumnViewModel.IsLoadingMore}"
                            Visibility="{x:Bind ColumnViewModel.IsLoadingMore, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <TextBlock
                Grid.Row="5"
                Margin="4,6,4,0"
                Text="{x:Bind FooterText(ColumnViewModel.LastUpdatedDisplay, ColumnViewModel.RefreshIntervalLabel)}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Border>
</UserControl>
