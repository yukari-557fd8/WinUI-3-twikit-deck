<Application
    x:Class="WinUI3TwikitDeck.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>

            <!--
              カラムとタイムラインタブの面・枠・文字。
              Default は参照元と同じ暗い面、Light は白系。固定の暗い色を置くとライトテーマで読めなくなる。
              HighContrast はシステム色に合わせる。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TweetMediaBackgroundBrush" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="TweetMediaPreviewBackgroundBrush" Color="#1E1E1E"/>
                    <SolidColorBrush x:Key="TweetMediaPreviewBorderBrush" Color="#555555"/>
                    <SolidColorBrush x:Key="DeckPageBackgroundBrush" Color="#202020"/>
                    <SolidColorBrush x:Key="ColumnBackgroundBrush" Color="#1F1F1F"/>
                    <SolidColorBrush x:Key="ColumnBorderBrush" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="TabViewBackground" Color="#252525"/>
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#1F1F1F"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#333333"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#8B98A5"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="#E7E9EA"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundPressed" Color="#E7E9EA"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#1D9BF0"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundDisabled" Color="#5C6770"/>
                    <SolidColorBrush x:Key="TabViewItemIconForeground" Color="#8B98A5"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundPointerOver" Color="#E7E9EA"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundPressed" Color="#E7E9EA"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundSelected" Color="#1D9BF0"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundDisabled" Color="#5C6770"/>
                    <SolidColorBrush x:Key="TabViewItemSeparator" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#1D9BF0"/>
                    <SolidColorBrush x:Key="TweetCardBackgroundBrush" Color="#1F1F1F"/>
                    <SolidColorBrush x:Key="TweetCardBorderBrush" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="QuotedTweetCardBackgroundBrush" Color="#1A1A1A"/>
                    <SolidColorBrush x:Key="QuotedTweetCardBorderBrush" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="QuotedTweetCardHoverBackgroundBrush" Color="#252525"/>
                    <SolidColorBrush x:Key="QuotedTweetCardHoverBorderBrush" Color="#3A3A3A"/>
                    <SolidColorBrush x:Key="CommandBarBackground" Color="#202020"/>
                    <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="#1F1F1F"/>
                    <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="CommandBarOverflowPresenterBackground" Color="#252525"/>
                    <SolidColorBrush x:Key="CommandBarOverflowPresenterBorderBrush" Color="#2A2A2A"/>
                    <SolidColorBrush x:Key="CommandBarForeground" Color="#E7E9EA"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TweetMediaBackgroundBrush" Color="#EFEFEF"/>
                    <SolidColorBrush x:Key="TweetMediaPreviewBackgroundBrush" Color="#EFEFEF"/>
                    <SolidColorBrush x:Key="TweetMediaPreviewBorderBrush" Color="#BDBDBD"/>
                    <SolidColorBrush x:Key="DeckPageBackgroundBrush" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="ColumnBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ColumnBorderBrush" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="TabViewBackground" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#EDEDED"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="#536471"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="#0F1419"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundPressed" Color="#0F1419"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="#1D9BF0"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundDisabled" Color="#8B98A5"/>
                    <SolidColorBrush x:Key="TabViewItemIconForeground" Color="#536471"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundPointerOver" Color="#0F1419"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundPressed" Color="#0F1419"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundSelected" Color="#1D9BF0"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundDisabled" Color="#8B98A5"/>
                    <SolidColorBrush x:Key="TabViewItemSeparator" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#1D9BF0"/>
                    <SolidColorBrush x:Key="TweetCardBackgroundBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="TweetCardBorderBrush" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="QuotedTweetCardBackgroundBrush" Color="#F7F7F7"/>
                    <SolidColorBrush x:Key="QuotedTweetCardBorderBrush" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="QuotedTweetCardHoverBackgroundBrush" Color="#EDEDED"/>
                    <SolidColorBrush x:Key="QuotedTweetCardHoverBorderBrush" Color="#C8C8C8"/>
                    <SolidColorBrush x:Key="CommandBarBackground" Color="#F3F3F3"/>
                    <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="CommandBarOverflowPresenterBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="CommandBarOverflowPresenterBorderBrush" Color="#E0E0E0"/>
                    <SolidColorBrush x:Key="CommandBarForeground" Color="#0F1419"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="TweetMediaBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="TweetMediaPreviewBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="TweetMediaPreviewBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="DeckPageBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="ColumnBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="ColumnBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TabViewBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="TabViewBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundDisabled" Color="Transparent"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemHeaderForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemIconForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundPointerOver" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemIconForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
                    <SolidColorBrush x:Key="TabViewItemSeparator" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                    <SolidColorBrush x:Key="TweetCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="TweetCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="QuotedTweetCardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="QuotedTweetCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="QuotedTweetCardHoverBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="QuotedTweetCardHoverBorderBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="CommandBarBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CommandBarBackgroundOpen" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CommandBarBorderBrushOpen" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CommandBarOverflowPresenterBackground" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CommandBarOverflowPresenterBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="CommandBarForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ツイートカードの操作ボタン / カラムヘッダーのアイコンボタン（透明背景、ホバー時だけ面が出る） -->
            <Style x:Key="DeckActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <Style x:Key="DeckIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
